# Nimiq Arena Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit real credentials, private keys, seeds, or production secrets to version control.

# Database Connection (MariaDB/MySQL)
DATABASE_URL="mysql://root:test@127.0.0.1:3307/nimiq_test"

# Server Port
PORT=3000

# Application ID for Mini App SDK / Webview
VITE_APP_ID="nimiq-arena-app"

# Session JWT Secret
# In development: may use local fallback.
# In production: MANDATORY. Must be a secure, random string (min 32 chars).
JWT_SECRET=""

# Nimiq Network Configuration
# 5 = Testnet, 42 = Mainnet
NIMIQ_NETWORK_ID=5
NIMIQ_RPC_URL="https://rpc.testnet.nimiqwatch.com"
NIMIQ_PAYMENT_RECIPIENT="NQ07 0000 0000 0000 0000 0000 0000 0000 0000"
NIMIQ_ARENA_ENTRY_VALUE_LUNA=100000
